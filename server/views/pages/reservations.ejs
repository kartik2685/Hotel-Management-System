<%- include('../partials/shell-top') %>
        <div class="page-header">
          <div>
            <p class="kicker">Front office</p>
            <h1 class="page-header__title">Reservations</h1>
            <p class="page-header__lead">Today’s arrivals, guests in house and the next ten days of bookings.</p>
          </div>
          <div class="page-header__actions">
            <button class="button button--secondary js-only" type="button" data-export-csv><%- icon('download') %>Export CSV</button>
            <a class="button button--primary" href="#new-booking"><%- icon('plus') %>New booking</a>
          </div>
        </div>
        <ul class="status-summary" aria-label="Bookings by status">
<% for (const s of r.summary) { -%>
          <li><span class="status-dot status-dot--<%= s.css %>" aria-hidden="true"></span><strong><%= s.count %></strong> <%= s.label %></li>
<% } -%>
        </ul>
        <section class="card card--flush" aria-labelledby="res-title">
          <h2 class="sr-only" id="res-title">Bookings</h2>
          <form class="filter-bar" data-reservation-filters role="search" aria-label="Filter bookings">
            <div class="field field--search">
              <label class="field-label" for="f-q">Search</label>
              <div class="icon-input"><%- icon('search') %><input class="input" id="f-q" name="q" type="search" placeholder="Guest, room or confirmation"></div>
            </div>
            <div class="field">
              <label class="field-label" for="f-status">Status</label>
              <select class="select" id="f-status" name="status">
                <option value="">All statuses</option>
                <option value="confirmed">Confirmed</option>
                <option value="tentative">Tentative</option>
                <option value="checked-in">Checked in</option>
                <option value="checked-out">Checked out</option>
                <option value="cancelled">Cancelled</option>
              </select>
            </div>
            <div class="field">
              <label class="field-label" for="f-source">Source</label>
              <select class="select" id="f-source" name="source">
                <option value="">All sources</option>
<% for (const s of r.sources) { -%>
                <option><%= s.name %></option>
<% } -%>
              </select>
            </div>
            <div class="field">
              <label class="field-label" for="f-from">Arriving from</label>
              <input class="input" id="f-from" name="from" type="date">
            </div>
            <div class="field">
              <label class="field-label" for="f-to">Arriving by</label>
              <input class="input" id="f-to" name="to" type="date">
            </div>
            <div class="field field--reset">
              <button class="button button--secondary" type="reset">Reset</button>
            </div>
          </form>
          <p class="result-count" aria-live="polite" data-reservation-count>Showing <%= r.rows.length %> of <%= fmt.plural(r.rows.length, 'booking', 'bookings') %></p>
          <div class="table-scroll">
            <table class="table bookings-table" data-reservation-table>
              <caption class="sr-only">Bookings, sortable by guest, stay and total</caption>
              <thead>
                <tr>
                  <th scope="col" aria-sort="none"><button class="sort-button" type="button" data-sort="name">Guest<%- icon('sort') %></button></th>
                  <th scope="col">Room</th>
                  <th scope="col" aria-sort="ascending"><button class="sort-button" type="button" data-sort="arrival">Stay<%- icon('sort') %></button></th>
                  <th scope="col">Source</th>
                  <th scope="col">Status</th>
                  <th scope="col" class="numeric" aria-sort="none"><button class="sort-button" type="button" data-sort="total">Total<%- icon('sort') %></button></th>
                </tr>
              </thead>
              <tbody>
<% for (const b of r.rows) { -%>
                <tr data-status="<%= b.statusCss %>" data-source="<%= b.source_name || '' %>" data-arrival="<%= b.arrival %>" data-total="<%= b.totalData %>" data-name="<%= b.sortName %>" data-email="<%= b.email || '' %>">
                  <td data-label="Guest"><span class="guest-cell"><span class="avatar avatar--sm" aria-hidden="true"><%= b.initials %></span><span class="guest-cell__text"><strong><a class="row-link" href="/reservations/<%= b.confirmation %>"><%= b.name %></a></strong><small class="text-mono"><%= b.confirmation %></small></span></span></td>
<% if (b.room_number) { -%>
                  <td data-label="Room"><strong><%= b.room_number %></strong><small class="cell-note"><%= b.type_name %></small></td>
<% } else { -%>
                  <td data-label="Room"><span class="text-muted">Unassigned</span><small class="cell-note"><%= b.type_name %></small></td>
<% } -%>
                  <td data-label="Stay"><span class="stay-dates"><%= b.from %> <span aria-hidden="true">→</span><span class="sr-only">to</span> <%= b.to %></span><small class="cell-note"><%= b.stayNote %></small></td>
                  <td data-label="Source"><%= b.source_name || '—' %></td>
                  <td data-label="Status"><span class="status-pill status-pill--<%= b.statusCss %>"><%= b.statusLabel %></span></td>
                  <td data-label="Total" class="numeric"><%= b.totalText %></td>
                </tr>
<% } -%>
              </tbody>
            </table>
          </div>
          <p class="empty-state" data-reservation-empty hidden>No bookings match these filters. <button class="text-button" type="button" data-reservation-reset>Clear filters</button></p>
        </section>
<% if (r.canBook) { -%>
        <section class="card booking" id="new-booking" aria-labelledby="nb-title" tabindex="-1">
          <div class="card__head">
            <div>
              <h2 class="card__title" id="nb-title">New booking</h2>
              <p class="card__subtitle"><%= r.taxNote %></p>
            </div>
          </div>
          <form class="booking-form" method="post" action="/reservations" data-booking-form novalidate>
<% if (r.form.seasons && r.form.seasons.length) { -%>
                <script type="application/json" id="rate-seasons"><%- JSON.stringify(r.form.seasons).replace(/</g, '\\u003c') %></script>
<% } -%>
            <input type="hidden" name="_csrf" value="<%= shell.csrf %>">
            <div class="booking-form__grid">
              <div class="booking-form__fields">
                <fieldset>
                  <legend>Stay</legend>
                  <div class="form-grid">
                    <div class="form-grid__col form-grid__col--half">
                      <label class="field-label" for="nb-arrival">Arrival</label>
                      <input class="input" id="nb-arrival" name="arrival" type="date" value="<%= r.form.arrival %>" min="<%= r.form.arrival %>" required aria-describedby="nb-arrival-err">
                      <p class="field-error" id="nb-arrival-err"></p>
                    </div>
                    <div class="form-grid__col form-grid__col--half">
                      <label class="field-label" for="nb-departure">Departure</label>
                      <input class="input" id="nb-departure" name="departure" type="date" value="<%= r.form.departure %>" min="<%= r.form.minDeparture %>" required aria-describedby="nb-departure-err">
                      <p class="field-error" id="nb-departure-err"></p>
                    </div>
                    <div class="form-grid__col form-grid__col--wide">
                      <label class="field-label" for="nb-type">Room type</label>
                      <select class="select" id="nb-type" name="type" required aria-describedby="nb-type-err">
<% for (const t of r.form.types) { -%>
                        <option value="<%= t.code %>" data-rate="<%= t.base_rate_cents / 100 %>" data-max="<%= t.max_guests %>"<%- t.code === r.form.type.code ? ' selected' : '' %>><%= t.name %> · <%= fmt.moneyWhole(t.base_rate_cents) %></option>
<% } -%>
                      </select>
                      <p class="field-error" id="nb-type-err"></p>
                    </div>
                    <div class="form-grid__col form-grid__col--narrow">
                      <label class="field-label" for="nb-adults">Adults</label>
                      <input class="input" id="nb-adults" name="adults" type="number" min="1" max="<%= r.form.maxGuests %>" value="2" required>
                    </div>
                    <div class="form-grid__col form-grid__col--narrow">
                      <label class="field-label" for="nb-children">Children</label>
                      <input class="input" id="nb-children" name="children" type="number" min="0" max="<%= r.form.maxGuests - 1 %>" value="0">
                    </div>
                  </div>
                  <div class="rate-plans" role="radiogroup" aria-label="Rate plan">
<% r.form.plans.forEach((p, i) => { -%>
                    <label class="rate-plan">
                      <input type="radio" name="plan" value="<%= p.code %>" data-adjust="<%= p.adjust %>"<%- i === 0 ? ' checked' : '' %>>
                      <span><strong><%= p.name %></strong><small><%= p.description %></small></span>
                    </label>
<% }) -%>
                  </div>
                </fieldset>
                <fieldset>
                  <legend>Guest</legend>
                  <div class="form-grid">
                    <div class="form-grid__col form-grid__col--wide">
                      <label class="field-label" for="nb-first">First name</label>
                      <input class="input" id="nb-first" name="first" type="text" autocomplete="given-name" required aria-describedby="nb-first-err">
                      <p class="field-error" id="nb-first-err"></p>
                    </div>
                    <div class="form-grid__col form-grid__col--wide">
                      <label class="field-label" for="nb-last">Last name</label>
                      <input class="input" id="nb-last" name="last" type="text" autocomplete="family-name" required aria-describedby="nb-last-err">
                      <p class="field-error" id="nb-last-err"></p>
                    </div>
                    <div class="form-grid__col form-grid__col--wide">
                      <label class="field-label" for="nb-email">Email</label>
                      <input class="input" id="nb-email" name="email" type="email" autocomplete="email" placeholder="guest@example.com" required aria-describedby="nb-email-err">
                      <p class="field-error" id="nb-email-err"></p>
                    </div>
                    <div class="form-grid__col form-grid__col--wide">
                      <label class="field-label" for="nb-phone">Phone <span class="field-label__hint">optional</span></label>
                      <input class="input" id="nb-phone" name="phone" type="tel" autocomplete="tel" placeholder="<%= shell.settings.country === 'IN' ? '+91 98765 43210' : '(312) 555-0142' %>">
                    </div>
                    <div class="form-grid__col form-grid__col--wide">
                      <label class="field-label" for="nb-source">Booking source</label>
                      <select class="select" id="nb-source" name="source">
<% for (const s of r.form.sources) { -%>
                        <option><%= s.name %></option>
<% } -%>
                      </select>
                    </div>
                  </div>
                </fieldset>
                <fieldset>
                  <legend>Extras and requests</legend>
                  <div class="extras">
<% for (const x of r.form.extras) { -%>
                    <label class="check-chip"><input type="checkbox" name="extra" value="<%= x.code %>" data-price="<%= x.price_cents / 100 %>" data-per="<%= x.per %>" data-tax="<%= x.tax %>"><span><%= x.name %> <small><%= fmt.moneyWhole(x.price_cents) %><%= x.per === 'night' ? ' / night' : '' %></small></span></label>
<% } -%>
                  </div>
                  <label class="field-label field-label--spaced" for="nb-requests">Special requests <span class="field-label__hint">optional</span></label>
                  <textarea class="input" id="nb-requests" name="requests" rows="3" placeholder="High floor, feather-free pillows, celebrating an anniversary…"></textarea>
                </fieldset>
              </div>
              <aside class="price-summary" aria-labelledby="price-title">
                <h3 class="price-summary__title" id="price-title">Price summary</h3>
                <p class="price-summary__room" data-quote="room"><%= r.form.type.name %> · <%= r.form.plans[0] ? r.form.plans[0].name : '' %></p>
                <p class="price-summary__dates" data-quote="dates"><%= fmt.formatDay(r.form.arrival) %> → <%= fmt.formatDay(r.form.departure) %> · <%= fmt.plural(r.form.quote.nights, 'night', 'nights') %></p>
                <dl class="price-summary__lines">
                  <div><dt data-quote="rate-label"><%= fmt.plural(r.form.quote.nights, 'night', 'nights') %> × <%= fmt.money(r.form.quote.rate) %></dt><dd data-quote="room-total"><%= fmt.money(r.form.quote.roomTotal) %></dd></div>
                  <div><dt><%= r.taxLine %></dt><dd data-quote="tax"><%= fmt.money(r.form.quote.tax) %></dd></div>
                  <div><dt>Extras</dt><dd data-quote="extras"><%= fmt.money(r.form.quote.extras) %></dd></div>
                </dl>
                <p class="price-summary__total"><span>Total</span><strong data-quote="total" aria-live="polite"><%= fmt.money(r.form.quote.total) %></strong></p>
                <p class="price-summary__note" data-quote="deposit">Deposit today: first night with tax, <%= fmt.money(r.form.deposit) %>.</p>
                <button class="button button--primary button--lg button--block" type="submit">Create booking</button>
                <p class="price-summary__fine">Bookings are saved straight away and show up on the tape chart and dashboard.</p>
              </aside>
            </div>
          </form>
          <div class="success-box" data-booking-success hidden tabindex="-1">
            <span class="success-box__icon"><%- icon('check') %></span>
            <div>
              <p class="success-box__title">Booking <span data-success-id>HLW-00000</span> added to the table</p>
              <p class="success-box__text" data-success-text></p>
              <div class="success-box__actions">
                <a class="button button--secondary button--sm" href="#res-title" data-success-view>View in list</a>
                <button class="button button--primary button--sm" type="button" data-booking-again>Create another</button>
              </div>
            </div>
          </div>
        </section>
<% } -%>
<%- include('../partials/shell-bottom') %>
