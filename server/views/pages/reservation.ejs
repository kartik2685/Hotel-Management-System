<%- include('../partials/shell-top') %>
<% const b = d.b; const rec = { arrival: b.arrival, departure: b.departure, room_type_id: b.room_type_id, room: b.room_number || '', adults: b.adults, children: b.children,
     rate_plan_id: b.rate_plan_id, nightly_rate: b.nightly_rate_cents / 100, source_id: b.source_id, eta: b.eta || '', notes: b.notes, requests: b.requests,
     first: b.first_name, last: b.last_name, email: b.email || '', phone: b.phone || '' };
   const v = (k) => (values[k] !== undefined ? values[k] : rec[k] ?? '');
   const err = (k) => errors[k] || ''; const inv = (k) => (errors[k] ? ' is-invalid' : '');
   const locked = !d.open || !canBook; -%>
        <div class="page-header">
          <div>
            <p class="kicker">Booking <span class="mono"><%= b.confirmation %></span></p>
            <h1 class="page-header__title"><%= b.name %></h1>
            <p class="page-header__lead"><%= b.type_name %><%= b.room_number ? ' ' + b.room_number : ' · room not assigned' %> · <%= b.from %> → <%= b.to %> · <%= fmt.plural(b.nights, 'night', 'nights') %> <span class="status-pill status-pill--<%= b.statusCss %>"><%= b.statusLabel %></span></p>
          </div>
          <div class="page-header__actions">
            <a class="button button--secondary" href="/guests?guest=<%= b.guest_id %>"><%- icon('users') %>Guest profile</a>
            <a class="button button--secondary" href="/reservations">Back to reservations</a>
          </div>
        </div>
<% if (flash) { -%>
        <div class="notice notice--ok" role="status"><%- icon('check') %><p><%= flash %></p></div>
<% } -%>
<% if (actionError) { -%>
        <div class="notice notice--error" role="alert"><%- icon('info') %><p><%= actionError %></p></div>
<% } -%>
<% if (Object.keys(errors).length) { -%>
        <div class="notice notice--error" role="alert"><%- icon('info') %><p>Please fix the highlighted fields. Nothing was saved yet.</p></div>
<% } -%>
        <div class="admin-grid">
          <form class="card" method="post" action="/reservations/<%= b.confirmation %>" novalidate>
            <input type="hidden" name="_csrf" value="<%= shell.csrf %>">
            <div class="card__head"><div><h2 class="card__title">Stay</h2><p class="card__subtitle"><%= locked ? (canBook ? 'This booking is closed; only the notes can change.' : 'Your account can view bookings but not change them.') : 'Change the dates, room or rate. Totals are worked out again when you save.' %></p></div></div>
            <fieldset<%- locked ? ' disabled' : '' %> style="border:0;margin:0;padding:0;min-width:0">
            <div class="form-grid">
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="b-arr">Arrival</label><input class="input<%= inv('arrival') %>" id="b-arr" name="arrival" type="date" value="<%= v('arrival') %>"><p class="field-error"><%= err('arrival') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="b-dep">Departure</label><input class="input<%= inv('departure') %>" id="b-dep" name="departure" type="date" value="<%= v('departure') %>"><p class="field-error"><%= err('departure') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="b-type">Room type</label>
                <select class="select<%= inv('room_type_id') %>" id="b-type" name="room_type_id"><% for (const t of d.types) { %><option value="<%= t.id %>"<%- String(v('room_type_id')) === String(t.id) ? ' selected' : '' %>><%= t.name %> (sleeps <%= t.max_guests %>)</option><% } %></select><p class="field-error"><%= err('room_type_id') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="b-room">Room <span class="field-label__hint">free rooms for these dates</span></label>
                <select class="select<%= inv('room') %>" id="b-room" name="room"><option value="">Not assigned yet</option><% for (const r of d.rooms) { %><option<%- String(v('room')) === String(r.number) ? ' selected' : '' %>><%= r.number %></option><% } %></select><p class="field-error"><%= err('room') %></p></div>
              <div class="form-grid__col form-grid__col--narrow"><label class="field-label" for="b-adults">Adults</label><input class="input<%= inv('adults') %>" id="b-adults" name="adults" type="number" min="1" max="12" value="<%= v('adults') %>"><p class="field-error"><%= err('adults') %></p></div>
              <div class="form-grid__col form-grid__col--narrow"><label class="field-label" for="b-children">Children</label><input class="input<%= inv('children') %>" id="b-children" name="children" type="number" min="0" max="12" value="<%= v('children') %>"><p class="field-error"><%= err('children') %></p></div>
              <div class="form-grid__col form-grid__col--narrow"><label class="field-label" for="b-eta">ETA</label><input class="input<%= inv('eta') %>" id="b-eta" name="eta" type="time" value="<%= v('eta') %>"><p class="field-error"><%= err('eta') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="b-plan">Rate plan</label>
                <select class="select" id="b-plan" name="rate_plan_id"><option value="">None</option><% for (const p of d.plans) { %><option value="<%= p.id %>"<%- String(v('rate_plan_id')) === String(p.id) ? ' selected' : '' %>><%= p.name %></option><% } %></select></div>
              <div class="form-grid__col form-grid__col--narrow"><label class="field-label" for="b-rate">Nightly rate (<%= fmt.symbol() %>)</label><input class="input<%= inv('nightly_rate') %>" id="b-rate" name="nightly_rate" inputmode="decimal" value="<%= v('nightly_rate') %>"><p class="field-error"><%= err('nightly_rate') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="b-source">Source</label>
                <select class="select" id="b-source" name="source_id"><option value="">Unknown</option><% for (const s of d.sources) { %><option value="<%= s.id %>"<%- String(v('source_id')) === String(s.id) ? ' selected' : '' %>><%= s.name %></option><% } %></select></div>
            </div>
            <div class="check-row" role="group" aria-label="Tags">
<% for (const [k, l] of [['early', 'Early arrival'], ['late', 'Late arrival'], ['anniversary', 'Anniversary']]) { const on = values['tag_' + k] !== undefined ? values['tag_' + k] : d.tags.includes(k); -%>
              <label><input type="checkbox" name="tag_<%= k %>"<%- on ? ' checked' : '' %>> <%= l %></label>
<% } -%>
            </div>
            <h3 class="form-section__title" style="margin-top:20px">Guest</h3>
            <div class="form-grid">
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="b-first">First name</label><input class="input<%= inv('first') %>" id="b-first" name="first" value="<%= v('first') %>"><p class="field-error"><%= err('first') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="b-last">Last name</label><input class="input<%= inv('last') %>" id="b-last" name="last" value="<%= v('last') %>"><p class="field-error"><%= err('last') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="b-email">Email</label><input class="input<%= inv('email') %>" id="b-email" name="email" type="email" value="<%= v('email') %>"><p class="field-error"><%= err('email') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="b-phone">Phone</label><input class="input<%= inv('phone') %>" id="b-phone" name="phone" type="tel" value="<%= v('phone') %>"><p class="field-error"><%= err('phone') %></p></div>
            </div>
            </fieldset>
            <div class="form-grid" style="margin-top:12px">
              <div class="form-grid__col"><label class="field-label" for="b-requests">Guest requests</label><textarea class="input<%= inv('requests') %>" id="b-requests" name="requests"<%- canBook ? '' : ' disabled' %>><%= v('requests') %></textarea><p class="field-error"><%= err('requests') %></p></div>
              <div class="form-grid__col"><label class="field-label" for="b-notes">Internal note <span class="field-label__hint">shown on the tape chart</span></label><textarea class="input<%= inv('notes') %>" id="b-notes" name="notes"<%- canBook ? '' : ' disabled' %>><%= v('notes') %></textarea><p class="field-error"><%= err('notes') %></p></div>
            </div>
<% if (canBook) { -%>
            <div class="form-actions"><button class="button button--primary" type="submit">Save booking</button></div>
<% } -%>
          </form>
          <div class="admin-stack">
            <section class="card" aria-labelledby="act-title">
              <div class="card__head"><div><h2 class="card__title" id="act-title">Status</h2><p class="card__subtitle"><%= b.statusLabel %><%= b.checked_in_at ? ' · in ' + b.checked_in_at.slice(5) : '' %><%= b.checked_out_at ? ' · out ' + b.checked_out_at.slice(5) : '' %></p></div></div>
<% if (canBook && d.can.confirm) { -%>
              <form method="post" action="/reservations/<%= b.confirmation %>/action" class="form-actions"><input type="hidden" name="_csrf" value="<%= shell.csrf %>"><input type="hidden" name="action" value="confirm"><button class="button button--secondary" type="submit">Confirm booking</button></form>
<% } -%>
<% if (canBook && d.can.checkIn) { -%>
              <form method="post" action="/reservations/<%= b.confirmation %>/action" class="form-actions"><input type="hidden" name="_csrf" value="<%= shell.csrf %>"><input type="hidden" name="action" value="check-in"><button class="button button--primary" type="submit"<%- d.can.checkInBlocked ? ' disabled' : '' %>><%- icon('key') %>Check in</button><% if (d.can.checkInBlocked) { %><span class="form-hint"><%= d.can.checkInBlocked %></span><% } %></form>
<% } -%>
<% if (canBook && d.can.checkOut) { -%>
              <form method="post" action="/reservations/<%= b.confirmation %>/action"><input type="hidden" name="_csrf" value="<%= shell.csrf %>"><input type="hidden" name="action" value="check-out">
<% if (d.owing > 0) { -%>
                <div class="check-row"><label><input type="checkbox" name="settle"> <%= fmt.money(d.owing) %> received in full</label></div>
<% } -%>
                <div class="form-actions"><button class="button button--primary" type="submit"><%- icon('sign-out') %>Check out</button></div></form>
<% } -%>
<% if (canBook && d.can.cancel) { -%>
              <form method="post" action="/reservations/<%= b.confirmation %>/action" style="margin-top:14px"><input type="hidden" name="_csrf" value="<%= shell.csrf %>"><input type="hidden" name="action" value="cancel">
                <div class="check-row"><label><input type="checkbox" name="sure"> Yes, cancel this booking</label></div>
                <div class="form-actions"><button class="button button--secondary" type="submit">Cancel booking</button></div></form>
<% } -%>
<% if (!d.open) { -%>
              <p class="form-hint">This booking is <%= b.statusLabel.toLowerCase() %>.</p>
<% } -%>
            </section>
            <section class="card" aria-labelledby="money-title">
              <div class="card__head"><div><h2 class="card__title" id="money-title">Money</h2></div></div>
              <dl class="money-lines">
                <div><dt><%= fmt.plural(b.nights, 'night', 'nights') %> × <%= fmt.money(b.nightly_rate_cents) %></dt><dd><%= fmt.money(b.room_total_cents) %></dd></div>
                <div><dt>Tax</dt><dd><%= fmt.money(b.tax_cents) %></dd></div>
<% for (const x of d.extras) { -%>
                <div><dt><%= x.name %></dt><dd><%= fmt.money(x.amount_cents) %></dd></div>
<% } -%>
                <div class="is-total"><dt><strong>Total</strong></dt><dd><%= fmt.money(b.total_cents) %></dd></div>
                <div><dt>Paid</dt><dd><%= fmt.money(b.paid_cents) %></dd></div>
                <div><dt>Still open</dt><dd><%= fmt.money(Math.max(0, d.owing)) %></dd></div>
              </dl>
<% if (canBook && d.owing > 0 && d.open) { -%>
              <form method="post" action="/reservations/<%= b.confirmation %>/payment" novalidate style="margin-top:16px">
                <input type="hidden" name="_csrf" value="<%= shell.csrf %>">
                <div class="form-grid">
                  <div class="form-grid__col form-grid__col--half"><label class="field-label" for="pay-amount">Payment (<%= fmt.symbol() %>)</label><input class="input<%= payErrors.amount ? ' is-invalid' : '' %>" id="pay-amount" name="amount" inputmode="decimal" value="<%= payValues.amount !== undefined ? payValues.amount : (d.owing / 100).toFixed(2) %>"><p class="field-error"><%= payErrors.amount || '' %></p></div>
                  <div class="form-grid__col form-grid__col--half"><label class="field-label" for="pay-method">Method</label><select class="select<%= payErrors.method ? ' is-invalid' : '' %>" id="pay-method" name="method"><% for (const m of ['Card', 'Cash', 'UPI', 'Bank transfer']) { %><option<%- payValues.method === m ? ' selected' : '' %>><%= m %></option><% } %></select><p class="field-error"><%= payErrors.method || '' %></p></div>
                </div>
                <div class="form-actions"><button class="button button--secondary" type="submit">Record payment</button></div>
              </form>
<% } -%>
            </section>
            <section class="card" aria-labelledby="log-title">
              <div class="card__head"><div><h2 class="card__title" id="log-title">History</h2><p class="card__subtitle">Created <%= b.created_at %></p></div></div>
<% if (d.log.length) { -%>
              <ul class="note-list"><% for (const l of d.log) { %><li><span class="avatar avatar--sm" aria-hidden="true"><%= fmt.initials(l.user_name) %></span><div><p><%= l.summary %></p><small><%= l.user_name %> · <%= l.created_at %></small></div></li><% } %></ul>
<% } else { -%>
              <p class="empty-state empty-state--inline">No changes since the booking was made.</p>
<% } -%>
            </section>
          </div>
        </div>
<%- include('../partials/shell-bottom') %>
