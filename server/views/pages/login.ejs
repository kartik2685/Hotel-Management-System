<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in · Frontdesk Hotel Management</title>
  <meta name="description" content="Staff sign-in for the Frontdesk property management system at <%= hotel.name %>.">
  <meta name="theme-color" content="#1c1b19">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <script src="/assets/js/theme-init.js"></script>
  <link rel="stylesheet" href="/assets/css/base.css">
  <link rel="stylesheet" href="/assets/css/layout.css">
  <link rel="stylesheet" href="/assets/css/components.css">
  <link rel="stylesheet" href="/assets/css/pages/login.css">
</head>
<body class="auth-page" data-page="login">
<%- include('../partials/sprite') -%>
  <a class="skip-link" href="#main">Skip to main content</a>

  <div class="auth">
    <div class="auth__visual">
      <img src="/assets/img/lobby.jpg" alt="Hotel lobby with marble columns, a patterned armchair and warm lamplight" width="1200" height="800">
      <div class="auth__visual-inner">
        <a class="logo logo--on-dark" href="/dashboard" aria-label="Frontdesk, go to dashboard">
          <span class="logo__mark"><%- icon('cloche') %></span>
          <span class="logo__word">Frontdesk</span>
        </a>
        <figure class="auth__quote">
          <blockquote><p>Every stay starts at the desk. Make the first two minutes count.</p></blockquote>
          <figcaption>House standards · <%= hotel.name %></figcaption>
        </figure>
        <ul class="auth__stats" aria-label="Tonight at <%= hotel.short %>">
          <li><strong><%= hotel.rooms %></strong><span>rooms</span></li>
          <li><strong><%= hotel.occupancy %>%</strong><span>sold tonight</span></li>
          <li><strong><%= hotel.arrivals %></strong><span>arrivals</span></li>
        </ul>
      </div>
    </div>
    <div class="auth__main">
      <header class="auth__header">
        <a class="logo" href="/dashboard" aria-label="Frontdesk, go to dashboard">
          <span class="logo__mark"><%- icon('cloche') %></span>
          <span class="logo__word">Frontdesk</span>
        </a>
        <button class="icon-button theme-switch js-only" type="button" aria-label="Dark theme" aria-pressed="false" data-theme-toggle>
          <span class="theme-switch__moon"><%- icon('moon') %></span>
          <span class="theme-switch__sun"><%- icon('sun') %></span>
        </button>
      </header>
      <main id="main" class="auth__card" tabindex="-1">
        <p class="kicker"><%= hotel.name %> · Front office</p>
        <h1 class="auth__title">Sign in to Frontdesk</h1>
        <p class="auth__lead">Use your staff email. Shared workstations sign out after <%= idleMinutes %> minutes idle.</p>
        <form class="auth__form" method="post" action="/login" data-login-form novalidate>
          <input type="hidden" name="_csrf" value="<%= loginToken %>">
          <input type="hidden" name="next" value="<%= next %>">
          <div class="form-group">
            <label class="field-label" for="login-email">Staff email</label>
            <div class="icon-input"><%- icon('mail') %><input class="input<%= errors.email ? ' is-invalid' : '' %>" id="login-email" name="email" type="email" autocomplete="username" placeholder="elena.marsh@example.com" required aria-describedby="login-email-err" value="<%= email %>"<%- errors.email ? ' aria-invalid="true"' : '' %>></div>
            <p class="field-error" id="login-email-err"><%= errors.email || '' %></p>
          </div>
          <div class="form-group">
            <label class="field-label" for="login-password">Password</label>
            <div class="icon-input icon-input--password"><%- icon('lock') %><input class="input<%= errors.password ? ' is-invalid' : '' %>" id="login-password" name="password" type="password" autocomplete="current-password" minlength="8" required aria-describedby="login-password-err"<%- errors.password ? ' aria-invalid="true"' : '' %>>
              <button class="password-toggle" type="button" aria-label="Show password" aria-pressed="false" data-password-toggle><span class="password-toggle__show"><%- icon('eye') %></span><span class="password-toggle__hide"><%- icon('eye-off') %></span></button>
            </div>
            <p class="field-error" id="login-password-err"><%= errors.password || '' %></p>
          </div>
          <div class="form-group">
            <label class="field-label" for="login-shift">Shift</label>
            <select class="select" id="login-shift" name="shift">
<% for (const s of shifts) { -%>
              <option value="<%= s.value %>"<%- s.value === shift ? ' selected' : '' %>><%= s.label %></option>
<% } -%>
            </select>
          </div>
          <div class="auth__row">
            <div class="checkbox">
              <input class="checkbox__input" type="checkbox" id="login-remember" name="remember"<%- remember ? ' checked' : '' %>>
              <label class="checkbox__label" for="login-remember">Keep me signed in on this workstation</label>
            </div>
            <button class="text-button" type="button" aria-expanded="false" aria-controls="reset-panel" data-reset-toggle>Forgot password?</button>
          </div>
          <button class="button button--primary button--lg button--block" type="submit">Sign in</button>
<% if (demoHint) { -%>
          <p class="auth__hint"><%- icon('info') %><%= demoHint %></p>
<% } -%>
        </form>
        <div class="reset-box" id="reset-panel" data-reset-panel hidden>
          <h2 class="reset-box__title">Reset your password</h2>
          <p>Enter your staff email and we will show you the next step.</p>
          <form class="reset-box__form" data-reset-form novalidate>
            <label class="sr-only" for="reset-email">Staff email</label>
            <input class="input" id="reset-email" type="email" placeholder="elena.marsh@example.com" required aria-describedby="reset-email-err">
            <button class="button button--secondary" type="submit">Continue</button>
          </form>
          <p class="field-error" id="reset-email-err"></p>
          <p class="reset-box__done" data-reset-done role="status" hidden>Thanks. Ask your manager or the hotel administrator to set a new password for you in Admin panel → Staff accounts.</p>
        </div>

        <div class="success-box auth__success" data-login-success hidden tabindex="-1" role="status">
          <span class="success-box__icon"><%- icon('check') %></span>
          <div>
            <p class="success-box__title">Signed in</p>
            <p class="success-box__text">Opening the dashboard…</p>
          </div>
        </div>
      </main>

      <footer class="site-footer site-footer--centered">
        <p>© <%= hotel.name %> · Frontdesk property management</p>
        <p>Template by <a href="https://uicookies.com/">uiCookies</a></p>
      </footer>
    </div>
  </div>

  <script src="/assets/js/core.js"></script>
  <script src="/assets/js/pages/login.js"></script>
</body>
</html>
