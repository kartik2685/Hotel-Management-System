<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= welcome ? 'Choose your password' : 'Choose a new password' %> · Frontdesk</title>
  <meta name="theme-color" content="#1c1b19">
  <meta name="robots" content="noindex">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <script src="/assets/js/theme-init.js"></script>
  <link rel="stylesheet" href="/assets/css/base.css">
  <link rel="stylesheet" href="/assets/css/layout.css">
  <link rel="stylesheet" href="/assets/css/components.css">
  <link rel="stylesheet" href="/assets/css/pages/admin.css">
</head>
<body class="auth-page error-page">
<%- include('../partials/sprite') -%>
  <main id="main" class="error-page__card card" tabindex="-1">
    <a class="logo" href="/login" aria-label="Frontdesk, go to sign in">
      <span class="logo__mark"><%- icon('cloche') %></span>
      <span class="logo__word">Frontdesk</span>
    </a>
<% if (!reset) { -%>
    <p class="kicker"><%= hotel.name %></p>
    <h1 class="page-header__title">This link has expired</h1>
<% if (welcome) { -%>
    <p class="page-header__lead">Invite links work once, for 7 days. Ask the person who invited you to send a new one from Admin panel → Staff accounts.</p>
<% } else { -%>
    <p class="page-header__lead">Password links work once, for a limited time. Ask for a new one from the sign-in page, or ask an administrator to send you one.</p>
<% } -%>
    <p class="error-page__actions"><a class="button button--primary" href="/login">Back to sign in</a></p>
<% } else { -%>
    <p class="kicker"><%= hotel.name %> · <%= reset.email %></p>
<% if (welcome) { -%>
    <h1 class="page-header__title">Welcome to <%= hotel.name %></h1>
    <p class="page-header__lead">Choose the password you will sign in with: at least 8 characters, and only you should know it.</p>
<% } else { -%>
    <h1 class="page-header__title">Choose a new password</h1>
    <p class="page-header__lead">Use at least 8 characters. You will be signed out on every device.</p>
<% } -%>
    <form method="post" action="/password/reset" novalidate>
      <input type="hidden" name="token" value="<%= token %>">
      <div class="form-grid">
        <div class="form-grid__col"><label class="field-label" for="r-new"><%= welcome ? 'Password' : 'New password' %></label><input class="input<%= errors.password ? ' is-invalid' : '' %>" id="r-new" name="password" type="password" autocomplete="new-password" minlength="8"><p class="field-error"><%= errors.password || '' %></p></div>
        <div class="form-grid__col"><label class="field-label" for="r-confirm"><%= welcome ? 'Password again' : 'New password again' %></label><input class="input<%= errors.confirm ? ' is-invalid' : '' %>" id="r-confirm" name="confirm" type="password" autocomplete="new-password"><p class="field-error"><%= errors.confirm || '' %></p></div>
      </div>
      <div class="form-actions"><button class="button button--primary" type="submit"><%= welcome ? 'Save password' : 'Save new password' %></button></div>
    </form>
<% } -%>
  </main>
</body>
</html>
