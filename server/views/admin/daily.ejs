<%- include('_top') %>
        <div class="card filter-bar daily-bar">
          <form class="cal-jump" method="get" action="/admin/daily"><label class="field-label" for="d-day">Report for</label><input class="input" id="d-day" name="day" type="date" max="<%= today %>" value="<%= r.day %>"><button class="button button--primary" type="submit">Show</button></form>
          <a class="button button--secondary" href="<%= whatsapp %>" target="_blank" rel="noopener"><%- icon('phone') %>Send on WhatsApp</a>
          <button class="button button--secondary" type="button" data-print><%- icon('printer') %>Print</button>
          <p class="form-hint daily-note"><%= r.closed ? 'This day was closed by the night audit.' : 'This day is not closed yet: its figures can still change.' %></p>
        </div>
        <h2 class="daily-title"><%= fmt.formatDay(r.day) %></h2>
        <div class="admin-cards">
          <div class="card admin-card"><span class="admin-card__num"><%= r.rooms.occupancy %>%</span><span class="admin-card__label">occupancy · <%= r.rooms.sold %> of <%= r.rooms.available %> rooms</span></div>
          <div class="card admin-card"><span class="admin-card__num"><%= fmt.moneyWhole(r.revenue.rooms) %></span><span class="admin-card__label">room revenue</span></div>
          <div class="card admin-card"><span class="admin-card__num"><%= fmt.moneyWhole(r.rooms.adr) %></span><span class="admin-card__label">ADR · RevPAR <%= fmt.moneyWhole(r.rooms.revpar) %></span></div>
          <div class="card admin-card"><span class="admin-card__num"><%= fmt.moneyWhole(r.money.in) %></span><span class="admin-card__label">money in<%= r.money.refunds ? ' · ' + fmt.moneyWhole(r.money.refunds) + ' refunded' : '' %></span></div>
        </div>
        <div class="admin-grid" style="margin-top:20px">
          <div class="admin-stack">
            <section class="card" aria-labelledby="d-money">
              <div class="card__head"><div><h2 class="card__title" id="d-money">Revenue and payments</h2><p class="card__subtitle"><%= fmt.formatDay(r.day) %></p></div></div>
              <dl class="money-lines">
                <div><dt>Rooms</dt><dd><%= fmt.money(r.revenue.rooms) %></dd></div>
                <div><dt>Food &amp; beverage <small class="cell-note">night audit</small></dt><dd><%= fmt.money(r.revenue.fnb) %></dd></div>
                <div><dt>Spa &amp; other <small class="cell-note">night audit</small></dt><dd><%= fmt.money(r.revenue.spa) %></dd></div>
                <div><dt>Charged to rooms <small class="cell-note">room service, laundry…</small></dt><dd><%= fmt.money(r.revenue.charges) %></dd></div>
<% for (const m of r.money.byMethod) { -%>
                <div><dt>Paid by <%= m.method %></dt><dd><%= fmt.money(m.amount) %></dd></div>
<% } -%>
                <div class="is-total"><dt><strong>Money in</strong></dt><dd><%= fmt.money(r.money.in) %></dd></div>
<% if (r.money.refunds) { -%>
                <div><dt>Refunds</dt><dd>−<%= fmt.money(r.money.refunds) %></dd></div>
<% } -%>
              </dl>
              <p class="form-hint"><%= fmt.plural(r.bookings.made, 'new booking', 'new bookings') %> worth <%= fmt.money(r.bookings.value) %><%= r.bookings.online ? ' (' + r.bookings.online + ' online)' : '' %> · <%= r.bookings.cancelled %> cancelled · <%= fmt.plural(r.bookings.noShows, 'no-show', 'no-shows') %></p>
            </section>
            <section class="card" aria-labelledby="d-week">
              <div class="card__head"><div><h2 class="card__title" id="d-week">The week ahead</h2><p class="card__subtitle">Rooms sold so far for each night</p></div></div>
              <ul class="week-bars">
<% for (const w of r.week) { -%>
                <li><span><%= fmt.formatDay(w.date) %></span><span class="week-bars__bar"><span style="width:<%= Math.min(100, w.occupancy) %>%"></span></span><strong><%= w.occupancy %>%</strong></li>
<% } -%>
              </ul>
            </section>
          </div>
          <div class="admin-stack">
            <section class="card" aria-labelledby="d-today">
              <div class="card__head"><div><h2 class="card__title" id="d-today"><%= fmt.formatDay(r.next) %></h2><p class="card__subtitle"><%= fmt.plural(r.arrivals.length, 'arrival', 'arrivals') %><%= r.vip ? ' (' + r.vip + ' VIP)' : '' %> · <%= fmt.plural(r.departures.length, 'departure', 'departures') %> · <%= r.inHouse.length %> in house · <%= r.outOfOrder %> out of order · <%= r.dirty %> to clean</p></div></div>
              <h3 class="form-section__title">Arrivals</h3>
              <ul class="note-list daily-list">
<% for (const a of r.arrivals) { -%>
                <li><div><p><a href="/reservations/<%= a.confirmation %>"><strong><%= a.name %></strong></a><%= a.vip ? ' · VIP' : '' %></p><p class="cell-note"><%= a.room ? 'Room ' + a.room : 'No room yet' %> · <%= a.status === 'checked_in' ? 'in' : 'expected' %></p></div></li>
<% } -%>
<% if (!r.arrivals.length) { -%>
                <li><p class="cell-note">No arrivals.</p></li>
<% } -%>
              </ul>
              <h3 class="form-section__title" style="margin-top:14px">Departures</h3>
              <ul class="note-list daily-list">
<% for (const d of r.departures) { -%>
                <li><div><p><a href="/reservations/<%= d.confirmation %>"><strong><%= d.name %></strong></a></p><p class="cell-note"><%= d.room ? 'Room ' + d.room : '' %> · <%= d.status === 'checked_out' ? 'left' : d.total_cents > d.paid_cents ? fmt.money(d.total_cents - d.paid_cents) + ' to collect' : 'paid' %></p></div></li>
<% } -%>
<% if (!r.departures.length) { -%>
                <li><p class="cell-note">No departures.</p></li>
<% } -%>
              </ul>
            </section>
            <section class="card" aria-labelledby="d-collect">
              <div class="card__head"><div><h2 class="card__title" id="d-collect">Still to collect</h2><p class="card__subtitle">From the guests in house</p></div></div>
              <p class="admin-card__num" style="margin:0"><%= fmt.money(r.toCollect) %></p>
<% if (r.dueOut.length) { -%>
              <p class="form-hint"><%= r.dueOut.length %> leaving <%= fmt.formatDay(r.next) %> still owe <%= fmt.money(r.dueOut.reduce((n, d) => n + d.total_cents - d.paid_cents, 0)) %>.</p>
<% } -%>
            </section>
            <section class="card" aria-labelledby="d-msg">
              <div class="card__head"><div><h2 class="card__title" id="d-msg">The message</h2><p class="card__subtitle">What “Send on WhatsApp” sends</p></div></div>
              <pre class="daily-message"><%= message %></pre>
            </section>
          </div>
        </div>
<%- include('_bottom') %>
