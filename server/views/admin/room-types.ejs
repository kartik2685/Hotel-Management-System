<%- include('_top') %>
<% const rec = editing ? (types.find((t) => t.id === editing.id) || {}) : {};
   const v = (k, d) => (values[k] !== undefined ? values[k] : rec[k] !== undefined && rec[k] !== null ? rec[k] : d ?? '');
   const err = (k) => errors[k] || ''; const inv = (k) => (errors[k] ? ' is-invalid' : ''); const currentGallery = editing ? (galleries[editing.id] || galleries[rec.code] || []) : []; -%>
        <div class="admin-grid">
          <section class="card card--flush" aria-labelledby="types-title">
            <h2 class="sr-only" id="types-title">Room types</h2>
            <div class="table-scroll">
              <table class="table admin-table">
                <thead><tr><th scope="col">Code</th><th scope="col">Name</th><th scope="col" class="numeric">Base rate</th><th scope="col" class="numeric">Sleeps</th><th scope="col" class="numeric">Rooms</th><th scope="col">Cleaning</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
                <tbody>
<% for (const t of types) { -%>
                  <tr<%- t.active ? '' : ' class="is-inactive"' %>><td class="mono"><%= t.code %></td><td><strong><%= t.name %></strong><% if (!t.active) { %> <span class="chip">Inactive</span><% } %></td><td class="numeric"><%= fmt.money(t.base_rate_cents) %></td><td class="numeric"><%= t.max_guests %></td><td class="numeric"><%= t.rooms %></td><td><%= t.clean_minutes %> / <%= t.service_minutes %> min</td><td class="actions"><a class="button button--secondary button--sm" href="/admin/room-types?edit=<%= t.id %>">Edit</a></td></tr>
<% } -%>
                </tbody>
              </table>
            </div>
          </section>
          <form class="card js-admin-upload" method="post" enctype="multipart/form-data" action="/admin/room-types<%= editing ? '/' + editing.id : '' %>" novalidate>
            <input type="hidden" name="_csrf" value="<%= shell.csrf %>">
            <div class="card__head"><div><h2 class="card__title"><%= editing ? 'Edit ' + (rec.name || 'room type') : 'Add a room type' %></h2><p class="card__subtitle">Cleaning times feed the housekeeping task sheets.</p></div></div>
            <div class="form-grid">
              <div class="form-grid__col form-grid__col--narrow"><label class="field-label" for="t-code">Code</label><input class="input<%= inv('code') %>" id="t-code" name="code" value="<%= v('code') %>" maxlength="6"><p class="field-error"><%= err('code') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="t-name">Name</label><input class="input<%= inv('name') %>" id="t-name" name="name" value="<%= v('name') %>"><p class="field-error"><%= err('name') %></p></div>
              <div class="form-grid__col form-grid__col--narrow"><label class="field-label" for="t-sort">List order</label><input class="input" id="t-sort" name="sort" type="number" min="0" max="999" value="<%= v('sort', 0) %>"></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="t-rate">Base rate per night (<%= fmt.symbol() %>)</label><input class="input<%= inv('base_rate') %>" id="t-rate" name="base_rate" inputmode="decimal" value="<%= values.base_rate !== undefined ? values.base_rate : rec.base_rate_cents !== undefined ? rec.base_rate_cents / 100 : '' %>"><p class="field-error"><%= err('base_rate') %></p></div>
              <div class="form-grid__col form-grid__col--narrow"><label class="field-label" for="t-max">Sleeps</label><input class="input<%= inv('max_guests') %>" id="t-max" name="max_guests" type="number" min="1" max="12" value="<%= v('max_guests', 2) %>"><p class="field-error"><%= err('max_guests') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="t-clean">Departure clean (min)</label><input class="input<%= inv('clean_minutes') %>" id="t-clean" name="clean_minutes" type="number" min="5" max="240" value="<%= v('clean_minutes', 40) %>"><p class="field-error"><%= err('clean_minutes') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="t-service">Stayover service (min)</label><input class="input<%= inv('service_minutes') %>" id="t-service" name="service_minutes" type="number" min="5" max="240" value="<%= v('service_minutes', 25) %>"><p class="field-error"><%= err('service_minutes') %></p></div>
            </div>
            <h3 class="form-section__title" style="margin-top:18px">On the website</h3>
            <div class="form-grid">
              <div class="form-grid__col"><label class="field-label" for="t-desc">Description</label><textarea class="input<%= inv('description') %>" id="t-desc" name="description" rows="3"><%= v('description') %></textarea><p class="field-error"><%= err('description') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="t-bed">Beds</label><input class="input" id="t-bed" name="bed" value="<%= v('bed') %>" placeholder="e.g. King bed"></div>
              <div class="form-grid__col form-grid__col--narrow"><label class="field-label" for="t-size">Size (m²)</label><input class="input<%= inv('size_sqm') %>" id="t-size" name="size_sqm" type="number" value="<%= v('size_sqm') %>"><p class="field-error"><%= err('size_sqm') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="t-photo">Photo <span class="field-label__hint">files in assets/img/rooms</span></label>
                <select class="select<%= inv('photo') %>" id="t-photo" name="photo"><option value="">No photo</option><% for (const p of photos) { %><option<%- v('photo') === p ? ' selected' : '' %>><%= p %></option><% } %></select><p class="field-error"><%= err('photo') %></p><label class="field-label" for="t-upload">Or upload a room photo</label><input class="input" id="t-upload" name="photo_upload" type="file" accept="image/jpeg,image/png,image/webp"><small>JPG, PNG or WebP, max 5 MB. Upload replaces the selected cover photo.</small><label class="field-label" for="t-gallery">Add more photos to the website gallery</label><input class="input" id="t-gallery" name="gallery_upload" type="file" accept="image/jpeg,image/png,image/webp" multiple><small>Select multiple extra photos (up to 10 files in one save, 5 MB each). Existing photos are kept and appended.</small><% if (currentGallery.length) { %><div class="admin-photo-list"><strong>Gallery now:</strong><% for (const photo of currentGallery) { %><span><%= photo.split('/').pop() %></span><% } %></div><% } %></div>
            </div>
            <div class="check-row"><label><input type="checkbox" name="active"<%- (values.active !== undefined ? values.active : rec.active !== 0) ? ' checked' : '' %>> Active (can be booked)</label><label><input type="checkbox" name="online"<%- (values.online !== undefined ? values.online : rec.online !== 0) ? ' checked' : '' %>> Bookable on the website</label></div>
            <p class="field-error"><%= err('active') %></p>
            <div class="form-actions"><button class="button button--primary" type="submit"><%= editing ? 'Save changes' : 'Add room type' %></button><% if (editing) { %><a class="button button--secondary" href="/admin/room-types">Cancel</a><% } %></div>
          </form>
        </div>
<%- include('_bottom') %>
