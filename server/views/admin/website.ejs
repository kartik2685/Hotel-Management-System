<%- include('_top') %>
<% const val = (k) => (values[k] !== undefined ? values[k] : s[k] ?? ''); const err = (k) => errors[k] || ''; const inv = (k) => (errors[k] ? ' is-invalid' : ''); -%>
<% if (photoError) { -%>
        <div class="notice notice--error" role="alert"><p><%= photoError %></p></div>
<% } -%>
        <div class="admin-cards site-stats">
          <div class="card admin-card"><span class="admin-card__num"><%= s.site_enabled ? 'On' : 'Off' %></span><span class="admin-card__label">website is <%= s.site_enabled ? 'open to guests' : 'closed to guests' %> · <a href="#site-text">switch</a></span></div>
          <div class="card admin-card"><span class="admin-card__num"><%= heroPhotos.length %></span><span class="admin-card__label">homepage hero photo(s) · <a href="#photos">manage</a></span></div>
          <div class="card admin-card"><span class="admin-card__num"><%= aboutPhotos.length %></span><span class="admin-card__label">about photo(s) · <a href="#photos">manage</a></span></div>
          <div class="card admin-card"><span class="admin-card__num"><%= types.filter((t) => t.shown).length %>/<%= types.length %></span><span class="admin-card__label">room type(s) on the site · <a href="#rooms">manage</a></span></div>
        </div>
        <div class="admin-grid">
          <form class="card" id="site-text" method="post" action="/admin/website" novalidate>
            <input type="hidden" name="_csrf" value="<%= shell.csrf %>">
            <div class="card__head"><div><h2 class="card__title">Words on the website</h2><p class="card__subtitle">Everything a guest reads on the public site, except the hotel details and the room descriptions.</p></div></div>
            <div class="check-row" style="margin-top:0"><label><input type="checkbox" name="site_enabled"<%- (values.site_enabled !== undefined ? values.site_enabled : s.site_enabled) ? ' checked' : '' %>> <strong>Website is on</strong> — guests can open <a href="/hotel" target="_blank" rel="noopener">/hotel</a> and book</label></div>
            <p class="form-hint">When it is off, guests see “Online booking is closed” and only signed-in staff can preview the site.</p>
            <div class="form-grid" style="margin-top:16px">
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="w-tag">Tagline <span class="field-label__hint">under the hotel name on the homepage</span></label><input class="input<%= inv('site_tagline') %>" id="w-tag" name="site_tagline" value="<%= val('site_tagline') %>" maxlength="140"><p class="field-error"><%= err('site_tagline') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="w-review">Google review link <span class="field-label__hint">sent in the thank-you email after check-out, not shown on the site</span></label><input class="input<%= inv('review_url') %>" id="w-review" name="review_url" value="<%= val('review_url') %>" placeholder="https://g.page/r/…/review"><p class="field-error"><%= err('review_url') %></p></div>
              <div class="form-grid__col"><label class="field-label" for="w-intro">Introduction <span class="field-label__hint">the “About” section</span></label><textarea class="input<%= inv('site_intro') %>" id="w-intro" name="site_intro" rows="4" maxlength="600"><%= val('site_intro') %></textarea><p class="field-error"><%= err('site_intro') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="w-amen">Amenities <span class="field-label__hint">one per line, up to 12</span></label><textarea class="input<%= inv('site_amenities') %>" id="w-amen" name="site_amenities" rows="5"><%= Array.isArray(val('site_amenities')) ? val('site_amenities').join('\n') : val('site_amenities') %></textarea><p class="field-error"><%= err('site_amenities') %></p></div>
              <div class="form-grid__col form-grid__col--half"><label class="field-label" for="w-pol">Policies <span class="field-label__hint">check-in, cancellation, pets…</span></label><textarea class="input<%= inv('site_policies') %>" id="w-pol" name="site_policies" rows="5" maxlength="800"><%= val('site_policies') %></textarea><p class="field-error"><%= err('site_policies') %></p></div>
            </div>
            <div class="form-actions"><button class="button button--primary" type="submit">Save website words</button><a class="button button--secondary" href="/hotel" target="_blank" rel="noopener">Open the website</a></div>
          </form>

          <section class="card" aria-labelledby="w-map-title">
            <div class="card__head"><div><h2 class="card__title" id="w-map-title">Everything on the website</h2><p class="card__subtitle">Where each part of the guest site is edited. Orange rows still need something.</p></div></div>
            <div class="table-scroll">
              <table class="table admin-table site-map">
                <thead><tr><th scope="col">On the website</th><th scope="col">Edited in</th><th scope="col">Now</th></tr></thead>
                <tbody>
<% for (const c of checklist) { -%>
                  <tr<%- c.ok ? '' : ' class="is-missing"' %>>
                    <td><strong><%= c.label %></strong><small class="cell-note"><%= c.where %></small></td>
                    <td><a class="text-button" href="<%= c.href %>"><%= c.ok ? 'Open' : 'Add' %></a></td>
                    <td class="mono"><%= c.ok ? c.value : 'Missing' %></td>
                  </tr>
<% } -%>
                </tbody>
              </table>
            </div>
            <p class="form-hint">Hotel name, city, address, phone, email, times and currency come from <a href="/admin/settings">Hotel settings</a>. Room names, descriptions, beds, sizes and the “bookable online” switch come from <a href="/admin/room-types">Room types</a>. Prices, rate plans and extras come from <a href="/admin/rates">Rates &amp; extras</a>. Availability, booking, cancellation and “manage my booking” work by themselves.</p>
          </section>
        </div>

        <section class="card" id="photos" aria-labelledby="w-photos-title" style="margin-top:22px">
          <div class="card__head"><div><h2 class="card__title" id="w-photos-title">Photos on the website</h2><p class="card__subtitle">The first hero photo is the big picture at the top of the homepage. Photos you upload here appear on the live site at once; the ones supplied with the app stay until you remove them.</p></div></div>
          <div class="site-photo-cols">
            <div class="site-photo-col">
              <h3>Homepage hero</h3>
              <p>The full-width carousel behind the hotel name and the booking form.</p>
<% if (heroPhotos.length) { -%>
              <div class="site-photo-grid">
<% heroPhotos.forEach((p, i) => { -%>
                <figure class="site-photo-tile">
                  <img src="<%= p.url %>" alt="Homepage photo <%= i + 1 %>" width="320" height="240" loading="lazy">
<% if (i === 0) { -%>
                  <span class="site-photo-tile__tags"><span class="chip chip--gold">Main photo</span></span>
<% } -%>
                  <figcaption class="site-photo-tile__actions">
<% if (i > 0) { -%>
                    <form class="inline-form" method="post" action="/admin/website/photos/hero/first"><input type="hidden" name="_csrf" value="<%= shell.csrf %>"><input type="hidden" name="name" value="<%= p.name %>"><button class="text-button" type="submit">Make first</button></form>
<% } -%>
                    <form class="inline-form" method="post" action="/admin/website/photos/hero/remove"><input type="hidden" name="_csrf" value="<%= shell.csrf %>"><input type="hidden" name="name" value="<%= p.name %>"><button class="text-button" type="submit">Remove</button></form>
                  </figcaption>
                </figure>
<% }) -%>
              </div>
<% } else { -%>
              <p class="site-photo-empty">No hero photos yet — the website shows a default photo (<a href="<%= defaultHero %>" target="_blank" rel="noopener">see it</a>).</p>
<% } -%>
              <form class="site-upload js-admin-upload" method="post" action="/admin/website/photos/hero" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= shell.csrf %>">
                <input class="input" type="file" name="photo_upload" accept="image/jpeg,image/png,image/webp" multiple required aria-label="Homepage hero photos">
                <button class="button button--secondary button--sm" type="submit">Upload hero photos</button>
              </form>
              <p class="form-hint">JPG, PNG or WebP · up to 5 at a time · 5 MB each.</p>
            </div>
            <div class="site-photo-col">
              <h3>About section</h3>
              <p>The photo beside the introduction in “A small hotel that knows your name”.</p>
<% if (aboutPhotos.length) { -%>
              <div class="site-photo-grid">
<% aboutPhotos.forEach((p, i) => { -%>
                <figure class="site-photo-tile">
                  <img src="<%= p.url %>" alt="About photo <%= i + 1 %>" width="320" height="240" loading="lazy">
                  <figcaption class="site-photo-tile__actions">
<% if (i > 0) { -%>
                    <form class="inline-form" method="post" action="/admin/website/photos/about/first"><input type="hidden" name="_csrf" value="<%= shell.csrf %>"><input type="hidden" name="name" value="<%= p.name %>"><button class="text-button" type="submit">Make first</button></form>
<% } -%>
                    <form class="inline-form" method="post" action="/admin/website/photos/about/remove"><input type="hidden" name="_csrf" value="<%= shell.csrf %>"><input type="hidden" name="name" value="<%= p.name %>"><button class="text-button" type="submit">Remove</button></form>
                  </figcaption>
                </figure>
<% }) -%>
              </div>
<% } else { -%>
              <p class="site-photo-empty">No about photos yet — the website shows a default photo.</p>
<% } -%>
              <form class="site-upload js-admin-upload" method="post" action="/admin/website/photos/about" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= shell.csrf %>">
                <input class="input" type="file" name="photo_upload" accept="image/jpeg,image/png,image/webp" multiple required aria-label="About section photos">
                <button class="button button--secondary button--sm" type="submit">Upload about photos</button>
              </form>
              <p class="form-hint">JPG, PNG or WebP · up to 5 at a time · 5 MB each.</p>
            </div>
          </div>
        </section>

        <section class="card" id="rooms" aria-labelledby="w-rooms-title" style="margin-top:22px">
          <div class="card__head"><div><h2 class="card__title" id="w-rooms-title">Room photos and galleries</h2><p class="card__subtitle">Each room card on the website shows its cover photo, then its gallery. Description, beds, size and “bookable online” are edited in <a href="/admin/room-types">Room types</a>.</p></div></div>
<% if (!types.length) { -%>
          <p class="site-photo-empty">No room types yet. <a href="/admin/room-types">Add a room type</a> before putting rooms on the website.</p>
<% } -%>
<% for (const t of types) { -%>
          <article class="site-room">
            <div class="site-room__head">
              <div>
                <h3><%= t.name %> <span class="mono"><%= t.code %></span> <span class="chip"><%= t.shown ? 'Shown on the website' : 'Hidden from the website' %></span></h3>
                <p class="cell-note"><%= t.cover ? 'Cover photo set' : 'No cover photo' %> · <%= t.gallery.length %> gallery photo(s)<% if (!t.online) { %> · <a href="/admin/room-types?edit=<%= t.id %>">tick “Bookable on the website”</a><% } %></p>
              </div>
              <a class="text-button" href="/admin/room-types?edit=<%= t.id %>">Description, beds, size</a>
            </div>
<% if (t.cover || t.gallery.length) { -%>
            <div class="site-photo-grid">
<% if (t.cover) { -%>
              <figure class="site-photo-tile">
                <img src="<%= t.cover %>" alt="<%= t.name %> cover photo" width="320" height="240" loading="lazy">
                <span class="site-photo-tile__tags"><span class="chip chip--gold">Cover</span></span>
                <figcaption class="site-photo-tile__actions">
                  <form class="inline-form" method="post" action="/admin/website/room/<%= t.id %>/photo/remove"><input type="hidden" name="_csrf" value="<%= shell.csrf %>"><input type="hidden" name="where" value="cover"><input type="hidden" name="name" value="<%= t.photo %>"><button class="text-button" type="submit">Remove cover</button></form>
                </figcaption>
              </figure>
<% } -%>
<% t.gallery.forEach((p, i) => { -%>
              <figure class="site-photo-tile">
                <img src="<%= p.url %>" alt="<%= t.name %> gallery photo <%= i + 1 %>" width="320" height="240" loading="lazy">
                <figcaption class="site-photo-tile__actions">
                  <form class="inline-form" method="post" action="/admin/website/room/<%= t.id %>/photo/remove"><input type="hidden" name="_csrf" value="<%= shell.csrf %>"><input type="hidden" name="where" value="gallery"><input type="hidden" name="name" value="<%= p.name %>"><button class="text-button" type="submit">Remove</button></form>
                </figcaption>
              </figure>
<% }) -%>
            </div>
<% } else { -%>
            <p class="site-photo-empty">No photos for this room type yet — its card on the website has no picture.</p>
<% } -%>
            <form class="site-upload js-admin-upload" method="post" action="/admin/website/room/<%= t.id %>/photo" enctype="multipart/form-data">
              <input type="hidden" name="_csrf" value="<%= shell.csrf %>">
              <label class="sr-only" for="room-cover-<%= t.id %>">New cover photo for <%= t.name %></label>
              <input class="input" id="room-cover-<%= t.id %>" type="file" name="photo_upload" accept="image/jpeg,image/png,image/webp">
              <label class="sr-only" for="room-gallery-<%= t.id %>">Gallery photos for <%= t.name %></label>
              <input class="input" id="room-gallery-<%= t.id %>" type="file" name="gallery_upload" accept="image/jpeg,image/png,image/webp" multiple>
              <button class="button button--secondary button--sm" type="submit">Upload photos</button>
            </form>
            <p class="form-hint">First box replaces the cover; the second adds to the gallery (up to 10 at a time, 5 MB each).</p>
          </article>
<% } -%>
        </section>

        <details class="card site-preview" id="preview">
          <summary>Live preview of the guest website</summary>
          <p class="form-hint">This is the real site, so anything you change above shows here when you reload it.</p>
          <iframe src="/hotel" title="Live guest website preview" loading="lazy" class="manual-site-frame"></iframe>
        </details>
<%- include('_bottom') %>
