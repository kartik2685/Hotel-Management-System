<%- include('_top') %>
<% if (typeof closeError !== 'undefined' && closeError) { -%>
        <div class="notice notice--error" role="alert"><%- icon('info') %><p><%= closeError %></p></div>
<% } -%>
        <div class="admin-grid">
          <div class="admin-stack">
            <section class="card" aria-labelledby="na-title">
              <div class="card__head"><div><h2 class="card__title" id="na-title">Business date: <%= a.day %></h2><p class="card__subtitle"><%= a.mode === 'fixed' ? 'Closing moves the date on to ' + a.next + '.' : 'The date follows the calendar; closing records today’s figures.' %><%= a.closed ? ' This day was closed before; closing again updates its figures.' : '' %></p></div></div>
              <dl class="booking-facts">
                <div><dt>Rooms sold</dt><dd><%= a.night.sold %> of <%= a.night.rooms %> (<%= a.night.occupancyText %>%)</dd></div>
                <div><dt>Room revenue</dt><dd><%= a.night.revenueText %></dd></div>
                <div><dt>ADR</dt><dd><%= a.night.adrText %></dd></div>
                <div><dt>RevPAR</dt><dd><%= a.night.revparText %></dd></div>
              </dl>
            </section>
            <section class="card" aria-labelledby="open-title">
              <div class="card__head"><div><h2 class="card__title" id="open-title">Still open</h2><p class="card__subtitle">Sort these out before closing the day.</p></div></div>
              <h3 class="form-section__title">Due out, still checked in (<%= a.dueOut.length %>)</h3>
<% if (a.dueOut.length) { -%>
              <ul class="note-list"><% for (const x of a.dueOut) { %><li><span class="status-icon tone-occupied" aria-hidden="true"><%- icon('user') %></span><div><p><a href="/reservations/<%= x.confirmation %>"><%= x.name %></a> · room <%= x.room || '—' %></p><small><%= x.confirmation %> · check out or extend the stay</small></div></li><% } %></ul>
<% } else { -%>
              <p class="empty-state empty-state--inline">Everyone due out has checked out.</p>
<% } -%>
<% if (form3.length) { -%>
              <h3 class="form-section__title" style="margin-top:18px">Form III reports to file (<%= form3.length %>)</h3>
              <ul class="note-list"><% for (const x of form3) { %><li><span class="status-icon tone-<%= x.overdue ? 'ooo' : 'dirty' %>" aria-hidden="true"><%- icon('info') %></span><div><p><a href="/reservations/<%= x.confirmation %>#form3"><%= x.name %></a> · <%= x.country %> · <%= x.kind %> report</p><small><%= x.overdue ? 'Overdue since' : 'Due by' %> <%= x.due %></small></div></li><% } %></ul>
<% } -%>
              <h3 class="form-section__title" style="margin-top:18px">Arrivals not checked in (<%= a.expected.length %>)</h3>
<% if (a.expected.length) { -%>
              <ul class="note-list"><% for (const x of a.expected) { %><li><span class="status-icon tone-clean" aria-hidden="true"><%- icon('luggage') %></span><div><p><a href="/reservations/<%= x.confirmation %>"><%= x.name %></a> · room <%= x.room || 'not assigned' %></p><small><%= x.confirmation %><%= x.eta ? ' · ETA ' + x.eta : '' %></small></div></li><% } %></ul>
<% } else { -%>
              <p class="empty-state empty-state--inline">All of today’s arrivals are in.</p>
<% } -%>
            </section>
          </div>
          <div class="admin-stack">
            <form class="card" method="post" action="/admin/night-audit/revenue" novalidate>
              <input type="hidden" name="_csrf" value="<%= shell.csrf %>">
              <div class="card__head"><div><h2 class="card__title">Outlet revenue for <%= a.day %></h2><p class="card__subtitle">From the restaurant and spa tills. Rooms revenue is added automatically.</p></div></div>
              <div class="form-grid">
                <div class="form-grid__col form-grid__col--half"><label class="field-label" for="na-fnb">Food &amp; beverage (<%= fmt.symbol() %>)</label><input class="input<%= errors.fnb ? ' is-invalid' : '' %>" id="na-fnb" name="fnb" inputmode="decimal" value="<%= values.fnb !== undefined ? values.fnb : a.fnb / 100 %>"><p class="field-error"><%= errors.fnb || '' %></p></div>
                <div class="form-grid__col form-grid__col--half"><label class="field-label" for="na-spa">Spa &amp; other (<%= fmt.symbol() %>)</label><input class="input<%= errors.spa ? ' is-invalid' : '' %>" id="na-spa" name="spa" inputmode="decimal" value="<%= values.spa !== undefined ? values.spa : a.spa / 100 %>"><p class="field-error"><%= errors.spa || '' %></p></div>
              </div>
              <div class="form-actions"><button class="button button--secondary" type="submit">Save outlet revenue</button></div>
            </form>
            <form class="card" method="post" action="/admin/night-audit" novalidate>
              <input type="hidden" name="_csrf" value="<%= shell.csrf %>">
              <div class="card__head"><div><h2 class="card__title">Close the day</h2><p class="card__subtitle"><%= a.mode === 'fixed' ? 'Records the figures, moves the date on and creates the next day’s housekeeping tasks.' : 'Records today’s figures and creates tomorrow’s housekeeping tasks. The date moves on by itself at midnight.' %></p></div></div>
              <div class="check-row"><label><input type="checkbox" name="no_shows"> Mark arrivals that never came as no-shows</label></div>
              <div class="form-actions"><button class="button button--primary" type="submit"><%- icon('calendar-check') %>Close <%= a.day %></button></div>
            </form>
          </div>
        </div>
<%- include('_bottom') %>
