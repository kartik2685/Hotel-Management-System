<%- include('_top') %>
<% if (demo) { -%>
        <div class="notice"><%- icon('info') %><p><strong>Demo data is loaded.</strong> All demo staff use the same password, shown on the sign-in page. Before real use, change the passwords in <a href="/admin/staff">Staff accounts</a>, set your hotel’s details in <a href="/admin/settings">Hotel settings</a> and turn demo mode off there.</p></div>
<% } -%>
        <div class="admin-cards">
<% for (const c of cards) { -%>
          <a class="card admin-card" href="<%= c.href %>"><span class="admin-card__num"><%= c.num %></span><span class="admin-card__label"><%= c.label %></span></a>
<% } -%>
        </div>
        <div class="admin-grid" style="margin-top:20px">
          <section class="card" aria-labelledby="recent-title">
            <div class="card__head"><div><h2 class="card__title" id="recent-title">Recent activity</h2><p class="card__subtitle">The latest changes across the hotel</p></div><a class="arrow-link" href="/admin/activity">Activity log<%- icon('chevron-right') %></a></div>
            <div class="table-scroll">
              <table class="table admin-table">
                <thead><tr><th scope="col">When</th><th scope="col">Who</th><th scope="col">What</th></tr></thead>
                <tbody>
<% for (const r of recent) { -%>
                  <tr><td class="mono"><%= r.created_at %></td><td><%= r.user_name %></td><td><%= r.summary %></td></tr>
<% } -%>
                </tbody>
              </table>
            </div>
          </section>
          <div class="admin-stack">
            <section class="card" aria-labelledby="day-title">
              <div class="card__head"><div><h2 class="card__title" id="day-title">Business date</h2><p class="card__subtitle"><%= businessDate %></p></div></div>
              <p class="form-hint">At the end of each day, run the night audit. It records the day’s figures, marks no-shows if you choose, moves the business date on and creates the next day’s housekeeping tasks.</p>
              <div class="form-actions"><a class="button button--primary" href="/admin/night-audit"><%- icon('calendar-check') %>Open the night audit</a></div>
            </section>
<% if (database) { -%>
            <section class="card" aria-labelledby="db-title">
              <div class="card__head"><div><h2 class="card__title" id="db-title">Database</h2><p class="card__subtitle"><%= database.name %><%= database.region ? ' · ' + database.region : '' %></p></div></div>
<% if (database.temporary) { -%>
              <div class="notice notice--error" role="alert"><%- icon('info') %><p><strong>The data is in a temporary file.</strong> Render’s free plan deletes it on every restart and redeploy and after 15 minutes without visitors. In Render → Environment, add <code>DATABASE_URL</code> with your Supabase connection string (Connect → Session pooler).</p></div>
<% } -%>
              <dl class="money-lines db-lines">
                <div><dt>Where</dt><dd class="mono"><%= database.where %></dd></div>
                <div><dt>Tables</dt><dd><%= database.tables %> · version <%= database.version %></dd></div>
                <div><dt>Size</dt><dd><%= database.size %></dd></div>
<% if (database.ms) { -%>
                <div><dt>Round trip</dt><dd><%= database.ms %></dd></div>
<% } -%>
                <div><dt>Last backup</dt><dd><%= lastBackup ? lastBackup.created_at + ' · ' + lastBackup.user_name : 'none yet' %></dd></div>
              </dl>
<% if (database.far) { -%>
              <p class="form-hint">The database is far from this server, so every page waits for it. Keep both in the same region (Singapore on Render and Supabase).</p>
<% } -%>
              <p class="form-hint">A backup is one file with every table in it. Supabase’s free plan keeps no backups of its own, so download one now and then and keep it safe: it holds guest details.</p>
              <form class="form-actions" method="post" action="/admin/backup">
                <input type="hidden" name="_csrf" value="<%= shell.csrf %>">
                <button class="button button--secondary" type="submit"><%- icon('download') %>Download a backup</button>
              </form>
            </section>
<% } -%>
          </div>
        </div>
<%- include('_bottom') %>
