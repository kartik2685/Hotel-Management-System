<%- include('_top') %>
<section class="card">
  <div class="card__head"><div><h2 class="card__title">Connection status</h2><p class="card__subtitle">This page reports configuration only. It never displays API keys or secrets.</p></div></div>
  <div class="integration-list">
    <% for (const item of integrations) { %>
      <article class="integration-row">
        <div><h3><%= item.label %></h3><p><%= item.detail %></p></div>
        <div class="integration-meta"><span class="chip"><%= item.status %></span><small>Provider: <%= item.provider %></small></div>
      </article>
    <% } %>
  </div>
  <div class="notice" role="note" style="margin-top:18px"><%- icon('info') %><p>Setup steps, required environment variables, webhook signing and the limits of each adapter are documented in <code>README.md → Integrations</code>.</p></div>
</section>
<%- include('_bottom') %>
