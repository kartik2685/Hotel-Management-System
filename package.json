{
  "name": "frontdesk-hms",
  "version": "1.0.0",
  "private": true,
  "description": "Frontdesk hotel management system: front office pages, staff logins and an admin panel on Node.js + SQLite.",
  "license": "MIT",
  "type": "commonjs",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/db/seed.js",
    "backup": "node --disable-warning=ExperimentalWarning server/db/backup.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"test/**/*.test.js\""
  },
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^5.3.0"
  }
}
