# Settings. On a hosting service (Render…) add these in its dashboard under Environment.
# On your own computer you can copy this file to .env instead; it is read at start-up and never committed.
# Everything is optional.

PORT=3000
HOST=0.0.0.0

# ---- Database: one of the two
# 1. PostgreSQL. On Render the Blueprint (render.yaml) fills this in by itself. From your own computer use the
#    database's External Database URL (Render → hotel-db → Connect → External), e.g. for npm run backup.
#    The tables are created automatically at the first start. Keep this secret: it contains the password.
# DATABASE_URL=postgresql://frontdesk:<password>@dpg-<id>-a.singapore-postgres.render.com/frontdesk
# 2. Without DATABASE_URL: a SQLite file (back this folder up!)
DB_PATH=./data/frontdesk.db

# ---- Live server (set these on the hosting service, not on your computer)
# NODE_ENV=production   # secure cookies, HSTS, no demo password hints
# TRUST_PROXY=1         # behind a proxy or load balancer (Render, Railway, nginx): detect client IPs and HTTPS
# COOKIE_SECURE=1       # HTTPS-only cookies; on by default in production. 0 only for plain-HTTP tests on a LAN.

# Sign-in lifetime
SESSION_IDLE_MINUTES=30
SESSION_REMEMBER_DAYS=30

# ---- Sending email (booking confirmations, password resets). Without these, emails wait in Admin → Emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# MAIL_FROM=Your Hotel <stay@yourhotel.com>

# ---- What a NEW database starts with (only used when the database is empty):
# - set ADMIN_EMAIL for an empty hotel with your own admin account (real use)
# ADMIN_EMAIL=you@yourhotel.com
# ADMIN_PASSWORD=choose-a-long-password
# ADMIN_NAME=Your Name
# HOTEL_NAME=Your Hotel
# - otherwise the demo hotel loads. Its staff password (8+ characters). With NODE_ENV=production and
#   no DEMO_PASSWORD, a random password is printed in the log instead of the public default.
# DEMO_PASSWORD=harlow-demo

# ---- Development only
# EMBED_PREVIEW=1   # allow the app inside another site's frame (live preview panels)
# PREVIEW_BAR=1     # "/" shows a Desktop / Tablet / Mobile preview bar
# HMS_NOW=2026-09-24T10:42   # freeze the hotel clock (demos, automated checks)
