# Copy to .env (or set these in your hosting dashboard). All are optional.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Where the SQLite database lives (back this folder up!)
DB_PATH=./data/frontdesk.db
# Behind a proxy or load balancer (Render, Railway, nginx) set this so client IPs and HTTPS are detected
TRUST_PROXY=1
# Cookies are Secure (HTTPS only) in production. Set to 0 only for plain-HTTP testing on a LAN.
COOKIE_SECURE=1
# Sign-in lifetime
SESSION_IDLE_MINUTES=30
SESSION_REMEMBER_DAYS=30
# Sending email (booking confirmations, password resets). Without these, emails wait in Admin → Emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# MAIL_FROM=Your Hotel <stay@yourhotel.com>
# Password for the demo staff accounts created by `npm run seed`
DEMO_PASSWORD=harlow-demo
# Development only
# EMBED_PREVIEW=1   # allow the app inside another site's frame (live preview panels)
# PREVIEW_BAR=1     # "/" shows a Desktop / Tablet / Mobile preview bar
# HMS_NOW=2026-09-24T10:42   # freeze the hotel clock (demos, automated checks)
